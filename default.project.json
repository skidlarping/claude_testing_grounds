{
  "name": "claude_testing_place",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },

      "Packages": {
        "$path": "src/packages"
      }
    },

    "ServerScriptService": {
      "Init": {
        "$path": "src/server"
      },

      "Services": {
        "$path": "src/services"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Init": {
          "$path": "src/client"
        },

        "Controllers": {
          "$path": "src/controllers"
        }
      }
    },

    "StarterGui": {
      "Main": {
        "$className": "ScreenGui",

        "Frames": {
          "$className": "Folder"
        },

        "HUD": {
          "$className": "Frame"
        }
      },

      "Effects": {
        "$className": "ScreenGui"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      },

      "GameObjects": {
        "$path": "src/game_objects"
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}